{
  "name": "deep-full-radio-study",
  "techs": {
    "enabled": [
      "fpv58_analog", "ocusync", "wifi", "hdzero", "walksnail",
      "elrs24", "rf24", "rf900", "crossfire868",
      "lr12g", "cell", "nr_a", "sim_bond",
      "leo", "mesh_manet", "fiber_tether"
    ],
    "max_links": 3,
    "force_include_any": [["elrs24", "rf900", "crossfire868", "rf24", "cell", "nr_a", "sim_bond", "ocusync", "wifi"]],
    "force_exclude": []
  },
  "scale": {
    "strategy": "pairwise",
    "duration_s": 120,
    "dt": 0.05,
    "seeds": 5,
    "master_seed": 2026,
    "max_combinations": 80,
    "max_runs": 5000,
    "scenarios": ["jammed_inspection", "urban_canyon"],
    "video_modes": ["standard"]
  },
  "policies": {
    "mode": "cross",
    "policies": ["reactive", "bonding", "pred_cost", "pred_threshold"]
  },
  "execution": {
    "backend": "high_fidelity",
    "workers": 2
  },
  "metrics": {
    "save_ticks": "none",
    "decimals": 6
  },
  "output": {
    "dir": "results/deep_full_study"
  }
}
