{
  "name": "native-radio-screen",
  "techs": {
    "enabled": ["rf24", "wifi", "cell"],
    "max_links": 2,
    "min_links": 1,
    "exclusive_groups": [],
    "radio_overrides": {}
  },
  "filters": {
    "require_control_link": true,
    "require_video_link": true,
    "min_control_coverage": 0.0,
    "min_video_coverage": 0.0,
    "drop_nonrealtime_links": true
  },
  "policies": {
    "policies": ["reactive", "bonding", "pred_cost"],
    "mode": "cross"
  },
  "scale": {
    "seeds": 1,
    "master_seed": 2026,
    "duration_s": 2.0,
    "dt": 0.05,
    "scenarios": ["jammed_inspection"],
    "strategy": "explicit",
    "explicit": [
      ["rf24"],
      ["wifi"],
      ["cell"],
      ["rf24", "wifi"]
    ],
    "max_combinations": 10,
    "max_runs": 100,
    "video_modes": ["standard"]
  },
  "metrics": {
    "source": "sim",
    "decimals": 9,
    "number_format": "fixed",
    "save_ticks": "first:1"
  },
  "execution": {
    "backend": "fast",
    "workers": 1,
    "calibrate": false
  },
  "output": {
    "dir": "results/study_demo"
  }
}
