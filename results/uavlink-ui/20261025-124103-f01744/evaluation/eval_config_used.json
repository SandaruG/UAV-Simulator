 "goals": [
  {
   "name": "Blind time cut >=50% vs reactive",
   "metric": "blind_time_s",
   "type": "relative_reduction",
   "target": 0.5,
   "margin": 0.0,
   "vs": "reactive*",
   "policy": null
  },
  {
   "name": "Blind time not worse than bonding by >1 s",
   "metric": "blind_time_s",
   "type": "noninferior",
   "target": 0.0,
   "margin": 1.0,
   "vs": "bonding*",
   "policy": null
  },
  {
   "name": "Blind time significantly lower than static",
   "metric": "blind_time_s",
   "type": "superior",
   "target": 0.0,
   "margin": 0.0,
   "vs": "static*",
   "policy": null
  },
  {
   "name": "Control p99 latency <= 150 ms",
   "metric": "ctrl_lat_p99_ms",
   "type": "absolute_max",
   "target": 150.0,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Control within 150 ms >= 99 %",
   "metric": "ctrl_within_150ms_rate",
   "type": "absolute_min",
   "target": 0.99,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Video quality not worse than reactive by >0.03",
   "metric": "video_quality_mean",
   "type": "noninferior",
   "target": 0.0,
   "margin": 0.03,
   "vs": "reactive*",
   "policy": null
  },
  {
   "name": "Video freeze time cut >=30% vs reactive",
   "metric": "video_freeze_s",
   "type": "relative_reduction",
   "target": 0.3,
   "margin": 0.0,
   "vs": "reactive*",
   "policy": null
  },
  {
   "name": "Mean comm power <= 8 W budget",
   "metric": "comm_power_mean_w",
   "type": "absolute_max",
   "target": 8.0,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Comm energy <=70% of bonding",
   "metric": "energy_comm_wh",
   "type": "relative_reduction",
   "target": 0.3,
   "margin": 0.0,
   "vs": "bonding*",
   "policy": null
  },
  {
   "name": "Outage-prediction AUC >= 0.90",
   "metric": "pred_auc",
   "type": "absolute_min",
   "target": 0.9,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Outage episode recall >= 0.90",
   "metric": "pred_ep_recall",
   "type": "absolute_min",
   "target": 0.9,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Mean warning lead time >= 1.0 s",
   "metric": "pred_lead_mean_s",
   "type": "absolute_min",
   "target": 1.0,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "False alarms <= 2 per minute",
   "metric": "pred_false_alarms_per_min",
   "type": "absolute_max",
   "target": 2.0,
   "margin": 0.0,
   "vs": null,
   "policy": null
  },
  {
   "name": "Brier score <= 0.10",
   "metric": "pred_brier",
   "type": "absolute_max",
   "target": 0.1,
   "margin": 0.0,
   "vs": null,
   "policy": null
  }
 ],
 "selection": {
